<!DOCTYPE html>
<html>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@500&family=Space+Mono:wght@700&display=swap" rel="stylesheet">
    <title>BugTracker | GMCubeDesigns </title>
      <%= favicon_link_tag 'neon_bug_logo.png' %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_include_tag :bugs %>
    <%= javascript_include_tag :replies %>
    <%= javascript_include_tag :application %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    
    <main>
      <div class="heading">
        <div class="authorized">
          <% if user_signed_in? %>
            <span>
              Logged in as:
              <%= current_user.email %>
            </span>
            <%= link_to 'Logout', destroy_user_session_path %>
          <% end %>
        </div>
        <% if alert %>
          <p class="alert alert-danger"><%= alert %></p>
        <% end %>
        <a href="https://gmcubedesigns.com/" target="_blank" class="logo">
          <%= image_tag 'gm_cubed_banner.png' %>
        </a>
      </div>
      <%= yield %>
    </main>
      <div id="cookie-consent-banner" class="cookie-consent-banner" role="dialog" aria-live="polite" aria-describedby="cookie-notice">
        <p id="cookie-notice">
          We use essential cookies to ensure secure sign-on and website functionality. These cookies are necessary and cannot be disabled.
          <a href="#" id="learn-more">Learn more</a>.
        </p>
        <button id="accept-cookies">OK</button>

        <!-- Modal (hidden by default) -->
        <div id="cookie-modal" class="cookie-modal hidden">
          <div class="cookie-modal-content">
            <span id="close-modal" class="close">&times;</span>
            <h2>Cookie Policy</h2>
            <p>We use only essential cookies to provide core functionality, such as secure sign-on and website security. These cookies are necessary and do not require consent.</p>
            <table>
              <tr>
                <th>Cookie Name</th>
                <th>Purpose</th>
                <th>Duration</th>
              </tr>
              <tr>
                <td>_my_app_session</td>
                <td>Manages user session for secure navigation</td>
                <td>Session (expires when browser closes)</td>
              </tr>
              <tr>
                <td>csrf_token</td>
                <td>Protects against cross-site request forgery attacks</td>
                <td>Session</td>
              </tr>
              <tr>
                <td>remember_user_token</td>
                <td>Allows persistent login (optional)</td>
                <td>Configurable (e.g., 2 weeks)</td>
              </tr>

              <tr>
                <td>cookieConsent</td>
                <td>Stores acknowledgment of cookie notice</td>
                <td>1 year</td>
              </tr>
            </table>
            <p>No tracking or third-party cookies are used.</p>
            <p>Contact us at [your-email] for data protection questions.</p>
          </div>
        </div>
      </div>
  </body>
</html>
